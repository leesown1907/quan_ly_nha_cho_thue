# Cổng chạy API
PORT=5000

# Khóa bí mật ký JWT (tự đặt chuỗi ngẫu nhiên mạnh trong file .env)
JWT_SECRET=<your-jwt-secret-here>
JWT_EXPIRES_IN=7d

# Kết nối PostgreSQL. Ví dụ:
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db_name>
# Nếu để trống, hệ thống tự dùng PostgreSQL nhúng (PGlite) lưu tại backend/data/pgdata
DATABASE_URL=
